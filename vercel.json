{
  "version": 2,
  "builds": [
    { "src": "frontend/vite.config.mjs", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist" } },
    { "src": "api/send-email.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/send-email", "dest": "/api/send-email.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ],
  "env": {
    "NODE_VERSION": "18"
  }
}

